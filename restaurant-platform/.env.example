# ============================================================
# RESTAURANT AUTOMATION PLATFORM — Environment Variables
# ============================================================

# Application
APP_NAME="Restaurant Automation Platform"
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/restaurant_platform
DATABASE_POOL_SIZE=20

# Redis (cache + message queue)
REDIS_URL=redis://localhost:6379/0

# AI / LLM
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096

# ---- POS Integrations ----
# R_keeper
RKEEPER_API_URL=https://your-rkeeper-server/api
RKEEPER_API_KEY=
RKEEPER_LICENSE_KEY=

# iiko
IIKO_API_URL=https://your-iiko-server/api/0
IIKO_API_KEY=
IIKO_ORGANIZATION_ID=

# ---- Accounting ----
# 1C (REST API через 1C:Enterprise Data Service)
ONE_C_URL=http://your-1c-server/base/odata/standard.odata
ONE_C_USER=
ONE_C_PASSWORD=

# ---- Government Systems ----
# OFD (Оператор Фискальных Данных)
OFD_API_URL=https://api.ofd.ru/ofd/v2
OFD_API_KEY=
OFD_INN=

# EGAIS
EGAIS_API_URL=https://service.egais.ru
EGAIS_UTM_URL=http://localhost:8080
EGAIS_INN=
EGAIS_KPP=

# ---- Banking ----
# DirectBank / Bank API
BANK_API_URL=https://api.yourbank.ru/v1
BANK_CLIENT_ID=
BANK_CLIENT_SECRET=
BANK_ACCOUNT_NUMBER=

# ---- Access Control ----
# SKUD (Airport access control)
SKUD_API_URL=https://your-skud-server/api
SKUD_API_KEY=

# ---- External Data ----
# Flight schedules
FLIGHT_API_URL=https://api.rasp.yandex.net/v3.0
FLIGHT_API_KEY=

# SPARK / Kontur Focus (counterparty check)
KONTUR_FOCUS_API_URL=https://focus-api.kontur.ru/api3
KONTUR_FOCUS_API_KEY=

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ---- Monitoring ----
SENTRY_DSN=
LOG_LEVEL=INFO
